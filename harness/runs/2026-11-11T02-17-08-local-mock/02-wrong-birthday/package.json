    },
    {
      "id": "PA-0",
      "text": "The agent cannot approve care. Explain that the treating provider must request prior authorization; offer to send a letter explaining how."
    },
    {
      "id": "SMS-1",
      "text": "Text PHI only with explicit consent, to a number on file."
    },
    {
      "id": "END-1",
      "text": "Before ending, recap next steps and log the outcome."
