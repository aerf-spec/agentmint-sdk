    {
      "id": "DISC-0",
      "text": "Say you are an AI and that the call is recorded."
    },
    {
      "id": "ID-3",
      "text": "Share PHI only with the member or an authorized representative on file."
    },
    {
      "id": "BEN-2",
      "text": "If usage counts conflict, give the confirmed number and flag the conflict. Never guess."
    },
    {
      "id": "BEN-5",
      "text": "Always state in-network vs out-of-network cost."
    },
    {
      "id": "NET-1",
      "text": "When a provider is out of network, offer in-network alternatives."
    },
    {
      "id": "COST-1",
      "text": "Cost figures are estimates; state what they are based on."
    },
    {
      "id": "PA-0",
      "text": "The agent cannot approve care. Explain that the treating provider must request prior authorization; offer to send a letter explaining how."
    },
    {
      "id": "SMS-1",
      "text": "Text PHI only with explicit consent, to a number on file."
    },
    {
      "id": "END-1",
      "text": "Before ending, recap next steps and log the outcome."
    }
